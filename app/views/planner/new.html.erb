<h1>Новая задача</h1>

<div class="card">
  <%= form_with model: @task, url: planner_path, local: true do |f| %>
    <% if @task.errors.any? %>
      <div class="errors">
        <% @task.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title, "Название" %>
      <%= f.text_field :title, placeholder: "Что нужно сделать?", required: true, autofocus: true %>
    </div>

    <div class="form-group">
      <%= f.label :description, "Описание" %>
      <%= f.text_area :description, rows: 2, placeholder: "Необязательно" %>
    </div>

    <div class="form-group">
      <%= f.label :priority, "Приоритет" %>
      <%= f.select :priority, [
        ["Низкий", "low"],
        ["Средний", "medium"],
        ["Высокий", "high"]
      ], { selected: "medium" } %>
    </div>

    <div class="form-group">
      <%= f.label :due_date, "Дата" %>
      <%= f.date_field :due_date, value: @task.due_date || params[:date] || Date.today %>
    </div>

    <div class="form-group">
      <%= f.label :recurrence, "Повторение" %>
      <%= f.select :recurrence, [
        ["Нет", ""],
        ["Каждый день", "daily"],
        ["По будням", "weekdays"],
        ["По выходным", "weekends"]
      ], { include_blank: "Нет" } %>
    </div>

    <%= f.submit "Добавить", class: "btn btn-block" %>
  <% end %>
</div>

<div style="margin-top: 16px;">
  <%= link_to "← Назад", planner_path, class: "btn btn-secondary btn-block" %>
</div>