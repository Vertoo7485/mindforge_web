<h1>Новая программа</h1>

<div class="card">
  <%= form_with model: @program, url: workouts_path, local: true do |f| %>
    <% if @program.errors.any? %>
      <div class="errors">
        <% @program.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :name, "Название программы" %>
      <%= f.text_field :name, required: true, placeholder: "Например: Мой сплит" %>
    </div>

    <div class="form-group">
      <%= f.label :description, "Описание" %>
      <%= f.text_area :description, rows: 2, placeholder: "Необязательно" %>
    </div>

    <div class="form-group">
      <%= f.label :level, "Уровень" %>
      <%= f.select :level, WorkoutProgram::LEVELS.map { |k, v| [v, k] } %>
    </div>

    <div class="form-group">
      <label>Упражнения</label>
      <% Exercise.for_user(current_user).group_by(&:muscle_group).each do |group, exercises| %>
        <div style="margin-bottom: 12px;">
          <div style="font-size: 12px; color: var(--amber); margin-bottom: 4px;"><%= Exercise::MUSCLE_GROUPS[group] %></div>
          <% exercises.each do |ex| %>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <%= check_box_tag "exercise_ids[]", ex.id, false, id: "ex_#{ex.id}" %>
              <%= label_tag "ex_#{ex.id}", ex.name, style: "flex: 1; font-size: 14px;" %>
              <%= number_field_tag "sets[]", 3, min: 1, 
                  style: "width: 50px; padding: 4px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-gold); border-radius: 6px; color: var(--text); font-size: 12px;",
                  placeholder: "Подх." %>
              <%= number_field_tag "reps[]", 10, min: 1,
                  style: "width: 50px; padding: 4px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-gold); border-radius: 6px; color: var(--text); font-size: 12px;",
                  placeholder: "Повт." %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= f.submit "Создать", class: "btn btn-block" %>
  <% end %>
</div>

<div style="margin-top: 16px;">
  <%= link_to "← Назад", workouts_path, class: "btn btn-secondary btn-block" %>
</div>