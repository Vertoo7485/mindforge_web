<h1>Редактировать долг</h1>

<div class="card">
  <%= form_with model: @debt, local: true do |f| %>
    <% if @debt.errors.any? %>
      <div class="errors">
        <% @debt.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title, "Название" %>
      <%= f.text_field :title, required: true %>
    </div>

    <div class="form-group">
      <%= f.label :total_amount, "Общая сумма (₽)" %>
      <%= f.number_field :total_amount, step: 0.01, required: true %>
    </div>

    <div class="form-group">
      <%= f.label :paid_amount, "Погашено (₽)" %>
      <%= f.number_field :paid_amount, step: 0.01 %>
    </div>

    <div class="form-group">
      <%= f.label :monthly_payment, "Ежемесячный платёж (₽)" %>
      <%= f.number_field :monthly_payment, step: 0.01 %>
    </div>

    <div class="form-group">
      <%= f.label :icon, "Иконка" %>
      <%= f.text_field :icon, maxlength: 2 %>
    </div>

    <%= f.submit "Сохранить", class: "btn btn-block" %>
  <% end %>
</div>

<div style="margin-top: 16px;">
  <%= link_to "← Назад", debts_path, class: "btn btn-secondary btn-block" %>
</div>