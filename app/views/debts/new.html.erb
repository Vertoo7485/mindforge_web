<h1>Новый долг</h1>

<div class="card">
  <%= form_with model: @debt, local: true do |f| %>
    <% if @debt.errors.any? %>
      <div class="errors">
        <% @debt.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title, "Название долга" %>
      <%= f.text_field :title, placeholder: "Например: Кредит", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :total_amount, "Общая сумма долга (₽)" %>
      <%= f.number_field :total_amount, step: 0.01, required: true %>
    </div>

    <div class="form-group">
      <%= f.label :paid_amount, "Уже погашено (₽)" %>
      <%= f.number_field :paid_amount, step: 0.01, value: 0 %>
    </div>

    <div class="form-group">
      <%= f.label :monthly_payment, "Ежемесячный платёж (₽)" %>
      <%= f.number_field :monthly_payment, step: 0.01, value: 0, 
          placeholder: "Для расчёта срока" %>
    </div>

    <div class="form-group">
      <%= f.label :icon, "Иконка (эмодзи)" %>
      <%= f.text_field :icon, placeholder: "💳", maxlength: 2 %>
    </div>

    <%= f.submit "Добавить", class: "btn btn-block" %>
  <% end %>
</div>

<div style="margin-top: 16px;">
  <%= link_to "← Назад", debts_path, class: "btn btn-secondary btn-block" %>
</div>