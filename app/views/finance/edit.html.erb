<h1>Редактировать транзакцию</h1>

<div class="card">
  <%= form_with model: @transaction, url: transaction_path(@transaction), method: :patch, local: true do |f| %>
    <% if @transaction.errors.any? %>
      <div class="errors">
        <% @transaction.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :transaction_type, "Тип" %>
      <%= f.select :transaction_type, [["Доход", "income"], ["Расход", "expense"]] %>
    </div>

    <div class="form-group">
      <%= f.label :amount, "Сумма (₽)" %>
      <%= f.number_field :amount, step: 0.01 %>
    </div>

    <div class="form-group">
      <%= f.label :category, "Категория" %>
      <%= f.text_field :category %>
    </div>

    <div class="form-group">
      <%= f.label :date, "Дата" %>
      <%= f.date_field :date %>
    </div>

    <div class="form-group">
      <%= f.label :note, "Заметка" %>
      <%= f.text_area :note, rows: 2 %>
    </div>

    <%= f.submit "Сохранить", class: "btn btn-block" %>
  <% end %>
</div>

<div style="margin-top: 16px;">
  <%= link_to "← Назад", finance_path, class: "btn btn-secondary btn-block" %>
</div>