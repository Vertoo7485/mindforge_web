<h1>Новая цель</h1>

<div class="card">
  <%= form_with model: @goal, local: true do |f| %>
    <% if @goal.errors.any? %>
      <div class="errors">
        <% @goal.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title, "Название цели" %>
      <%= f.text_field :title, placeholder: "Например: Отпуск", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :target_amount, "Целевая сумма (₽)" %>
      <%= f.number_field :target_amount, step: 0.01, required: true %>
    </div>

    <div class="form-group">
      <%= f.label :current_amount, "Уже накоплено (₽)" %>
      <%= f.number_field :current_amount, step: 0.01, value: 0 %>
    </div>

    <div class="form-group">
      <%= f.label :deadline, "Дедлайн (необязательно)" %>
      <%= f.date_field :deadline %>
    </div>

    <div class="form-group">
      <%= f.label :icon, "Иконка (эмодзи)" %>
      <%= f.text_field :icon, placeholder: "🎯", maxlength: 2 %>
    </div>

    <%= f.submit "Создать", class: "btn btn-block" %>
  <% end %>
</div>

<div style="margin-top: 16px;">
  <%= link_to "← Назад", savings_goals_path, class: "btn btn-secondary btn-block" %>
</div>