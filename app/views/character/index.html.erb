<h1>Персонаж</h1>

<!-- Карточка персонажа -->
<div class="card balance-card" style="border-color: var(--amber);">
  <div style="font-size: 48px; margin-bottom: 8px;">⚔️</div>
  <div class="balance-label">Уровень <%= @character.level %> · <%= @character.rank %></div>
  <div class="balance-amount" style="font-size: 36px;">
    <%= @character.xp %> / <%= @character.xp_to_next_level %> XP
  </div>
  
  <div class="progress-bar" style="margin-top: 12px; height: 10px;">
    <div class="progress-fill" style="width: <%= @character.xp_percent %>%; background: linear-gradient(90deg, var(--amber), #ffd700);"></div>
  </div>
  
  <div style="margin-top: 16px; display: flex; justify-content: center; gap: 24px;">
    <div>
      <div class="balance-label">Монеты</div>
      <div style="font-family: 'Cinzel', serif; font-size: 24px; color: var(--amber); font-weight: bold;">
        🪙 <%= @character.coins %>
      </div>
    </div>
  </div>
</div>

<!-- Достижения -->
<h3>Достижения</h3>

<% if @achievements.any? %>
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
    <% @achievements.each do |achievement| %>
      <% unlocked = @unlocked_ids.include?(achievement.id) %>
      <div class="card" style="padding: 12px; <%= 'border-color: var(--amber);' if unlocked %> <%= 'opacity: 0.5;' unless unlocked %>">
        <div style="display: flex; gap: 8px; align-items: center;">
          <div style="font-size: 28px;"><%= achievement.icon %></div>
          <div style="flex: 1;">
            <div style="font-family: 'Cinzel', serif; font-size: 13px; font-weight: bold; <%= 'color: var(--amber);' if unlocked %>">
              <%= achievement.title %>
            </div>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
              <%= achievement.description %>
            </div>
          </div>
          <% if unlocked %>
            <div style="color: var(--green); font-size: 18px;">✓</div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card">
    <p style="color: var(--text-muted);">Достижения загружаются...</p>
  </div>
<% end %>

<div style="margin-top: 24px;">
  <%= link_to "← На главную", dashboard_path, class: "btn btn-secondary btn-block" %>
</div>