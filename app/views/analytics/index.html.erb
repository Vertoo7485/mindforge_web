<h1>Аналитика</h1>

<!-- Фильтры -->
<div class="filters">
  <%= link_to "Всё", analytics_path, class: "filter-btn #{'active' if @period == 'all'}" %>
  <%= link_to "Неделя", analytics_path(period: 'week'), class: "filter-btn #{'active' if @period == 'week'}" %>
  <%= link_to "Месяц", analytics_path(period: 'month'), class: "filter-btn #{'active' if @period == 'month'}" %>
  <%= link_to "Год", analytics_path(period: 'year'), class: "filter-btn #{'active' if @period == 'year'}" %>
</div>

<!-- Сводка -->
<div class="card">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
    <div>
      <div class="balance-label">Доходы</div>
      <div style="font-family: 'Cinzel', serif; font-size: 24px; color: var(--green); font-weight: bold; margin-top: 4px;">
        +<%= number_to_currency(@total_income, unit: "₽", precision: 0) %>
      </div>
    </div>
    <div>
      <div class="balance-label">Расходы</div>
      <div style="font-family: 'Cinzel', serif; font-size: 24px; color: var(--red); font-weight: bold; margin-top: 4px;">
        −<%= number_to_currency(@total_expense, unit: "₽", precision: 0) %>
      </div>
    </div>
  </div>
</div>

<!-- Круговая диаграмма расходов (CSS) -->
<% if @expenses_by_category.any? %>
  <h3>Расходы по категориям</h3>
  <div class="card">
    <% total_expense = @expenses_by_category.values.sum %>
    <% colors = ['#e15554', '#7b68ee', '#e8b84b', '#4ecdc4', '#d4a574', '#8b5cf6', '#f59e0b', '#10b981'] %>
    
    <!-- Стеклянная полоса-диаграмма -->
    <div style="display: flex; height: 32px; border-radius: 8px; overflow: hidden; margin-bottom: 16px;">
      <% @expenses_by_category.each_with_index do |(cat, amount), i| %>
        <% percent = (amount / total_expense * 100) %>
        <div style="width: <%= percent %>%; background: <%= colors[i % colors.length] %>;" title="<%= cat %>: <%= amount.to_i %> ₽"></div>
      <% end %>
    </div>

    <!-- Легенда -->
    <% @expenses_by_category.each_with_index do |(cat, amount), i| %>
      <% percent = (amount / total_expense * 100).round(1) %>
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 14px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <div style="width: 12px; height: 12px; border-radius: 3px; background: <%= colors[i % colors.length] %>;"></div>
          <span><%= cat %></span>
        </div>
        <span style="color: var(--text-muted);">
          <%= number_to_currency(amount, unit: "₽", precision: 0) %> (<%= percent %>%)
        </span>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Доходы по категориям -->
<% if @incomes_by_category.any? %>
  <h3>Доходы по категориям</h3>
  <div class="card">
    <% @incomes_by_category.each do |cat, amount| %>
      <div style="display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px;">
        <span><%= cat %></span>
        <span style="color: var(--green); font-weight: bold;">
          +<%= number_to_currency(amount, unit: "₽", precision: 0) %>
        </span>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Динамика по месяцам -->
<% if @monthly_data.any? %>
  <h3>Динамика по месяцам</h3>
  <div class="card">
    <% max_value = @monthly_data.values.flat_map(&:values).max.to_f %>
    <% max_value = 1 if max_value == 0 %>
    
    <% @monthly_data.each do |month, data| %>
      <div style="margin-bottom: 16px;">
        <div style="font-size: 13px; color: var(--text-muted); margin-bottom: 4px;"><%= month %></div>
        
        <!-- Доход -->
        <% if data[:income] > 0 %>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 2px;">
            <div style="flex: 0 0 80px; font-size: 11px; color: var(--green);">Доход</div>
            <div style="flex: 1; background: rgba(0,0,0,0.3); border-radius: 4px; height: 16px; overflow: hidden;">
              <div style="width: <%= (data[:income] / max_value * 100) %>%; height: 100%; background: linear-gradient(90deg, var(--green), rgba(78,205,196,0.5));"></div>
            </div>
            <div style="flex: 0 0 80px; text-align: right; font-size: 12px; color: var(--green);">
              <%= number_to_currency(data[:income], unit: "", precision: 0) %>
            </div>
          </div>
        <% end %>
        
        <!-- Расход -->
        <% if data[:expense] > 0 %>
          <div style="display: flex; align-items: center; gap: 8px;">
            <div style="flex: 0 0 80px; font-size: 11px; color: var(--red);">Расход</div>
            <div style="flex: 1; background: rgba(0,0,0,0.3); border-radius: 4px; height: 16px; overflow: hidden;">
              <div style="width: <%= (data[:expense] / max_value * 100) %>%; height: 100%; background: linear-gradient(90deg, var(--red), rgba(225,85,84,0.5));"></div>
            </div>
            <div style="flex: 0 0 80px; text-align: right; font-size: 12px; color: var(--red);">
              <%= number_to_currency(data[:expense], unit: "", precision: 0) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div style="margin-top: 16px;">
  <%= link_to "← Назад к финансам", finance_path, class: "btn btn-secondary btn-block" %>
</div>