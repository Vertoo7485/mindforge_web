<h1>Редактировать бюджет</h1>

<div class="card">
  <%= form_with model: @budget, local: true do |f| %>
    <% if @budget.errors.any? %>
      <div class="errors">
        <% @budget.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :category, "Категория" %>
      <%= f.text_field :category, required: true %>
    </div>

    <div class="form-group">
      <%= f.label :amount, "Лимит (₽)" %>
      <%= f.number_field :amount, step: 0.01, required: true %>
    </div>

    <div class="form-group">
      <%= f.label :period, "Период" %>
      <%= f.select :period, [["В месяц", "monthly"], ["В неделю", "weekly"]] %>
    </div>

    <%= f.submit "Сохранить", class: "btn btn-block" %>
  <% end %>
</div>

<div style="margin-top: 16px;">
  <%= link_to "← Назад", budgets_path, class: "btn btn-secondary btn-block" %>
</div>